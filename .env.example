# HealthWise AI — Environment Variables Configuration

# Puter.js AI Configuration (No OpenAI/Anthropic keys needed)
# Model can be customized without changing codebase
# Leave default or configure specific supported model from Puter
VITE_PUTER_AI_MODEL=gpt-4o-mini
VITE_ENABLE_MOCK_AI=false

# Supabase Configuration (Database & Application Auth)
# Obtain these from your Supabase project dashboard -> Settings -> API
# NEVER expose the service_role key in client-side code
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Settings
VITE_APP_NAME="HealthWise AI"
VITE_APP_ENV=development
VITE_DEFAULT_LANGUAGE=en
